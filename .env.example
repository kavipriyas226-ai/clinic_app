# Base URL the frontend calls for the API, including the /api suffix.
# This repo's committed .env already points at the production Render backend:
#   https://clinic_appbackendend.onrender.com/api
# For local development against a backend running on your own machine, create a
# .env.local (gitignored, takes precedence over .env) with:
#   VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=https://clinic_appbackendend.onrender.com/api
